-- 2. menu_items
-- ---------------------------------------------------------------------
INSERT INTO content.menu_items (menu_category_id, name, description)
SELECT mc.menu_category_id, v.name, v.description
FROM (VALUES
    -- CAFÉ
    ('café', 'espresso', NULL),
    ('café', 'café descafeinado', NULL),
    ('café', 'cortado', 'Espresso y espuma de leche.'),
    ('café', 'cappuccino', 'Espresso, leche caliente, espuma de leche y canela.'),
    ('café', 'café destilado', NULL),
    ('café', 'chocolate caliente', NULL),
    ('café', 'café con leche', NULL),
    ('café', 'crema de leche batida o esencia', NULL),
    ('café', 'té gourmet metropolitan', NULL),
    ('café', 'té o mate', NULL),

    -- CAFÉS ESPECIALES
    ('cafés especiales', 'café latte', 'Espresso, esencia a escoger, leche batida, crema de leche batida y chocolate raspado.'),
    ('cafés especiales', 'cappuccino con esencias', 'Espresso, leche caliente, espuma de leche, canela con esencia.'),
    ('cafés especiales', 'café mocha', 'Espresso, chocolate, leche batida, crema de leche batida y chocolate raspado.'),
    ('cafés especiales', 'café bombón', 'Espresso con leche condensada.'),
    ('cafés especiales', 'latte frío', 'Espresso con leche, hielo y esencia.'),
    ('cafés especiales', 'café irlandés', 'Espresso con whisky, azúcar & crema de leche batida.'),
    ('cafés especiales', 'café amaretto', 'Café con amaretto & crema de leche batida.'),
    ('cafés especiales', 'iced cold brew hazelnut macchiato', 'Nuestro Cold Brew con Macchiato con esencia a escoger.'),
    ('cafés especiales', 'iced cold brew vanilla macchiato', 'Nuestro Cold Brew con Macchiato con esencia a escoger.'),
    ('cafés especiales', 'iced cold brew caramel macchiato', 'Nuestro Cold Brew con Macchiato con esencia a escoger.'),
    ('cafés especiales', 'iced cold brew mocha con chocolate casero', 'Nuestro Cold Brew con Mocha en deliciosa versión de chocolate casero.'),
    ('cafés especiales', 'cold brew americano', 'Café extraído a partir de infusión en agua fría.'),
    ('cafés especiales', 'cold brew con agua tónica', 'Nuestro Cold Brew con agua tónica.'),
    ('cafés especiales', 'iced latte cold brew', 'Nuestro Cold Brew con Latte con esencia a escoger.'),

    -- BEBIDAS
    ('bebidas', 'agua natural', 'con o sin gas'),
    ('bebidas', 'jugo de la estación con agua', NULL),
    ('bebidas', 'jugo de la estación con leche', NULL),
    ('bebidas', 'limonada con frutilla', NULL),
    ('bebidas', 'limonada con hierba buena', NULL),
    ('bebidas', 'limonada con menta', NULL),
    ('bebidas', 'piña buena', NULL),
    ('bebidas', 'zumo', NULL),
    ('bebidas', 'té helado', 'Té, azúcar, hielo, acompañado con hierba buena y limón.'),
    ('bebidas', 'gaseosa', NULL),
    ('bebidas', 'gaseosa dietética', NULL),

    -- SMOOTHIES
    ('smoothies', 'smoothie de kiwi con plátano', 'Batido frío de kiwi y plátano con helado.'),
    ('smoothies', 'smoothie de frutos rojos y piña', 'Batido frío de frutos rojos y piña con helado.'),
    ('smoothies', 'smoothie de frambuesa con durazno', 'Batido frío de frambuesa y durazno con helado.'),
    ('smoothies', 'té gourmet frappeado', 'Hielo picado con té gourmet a elección con azúcar o edulcorante.'),

    -- BATIDOS
    ('batidos', 'frappé', 'Hielo picado con frutas frescas de la estación y azúcar o edulcorante.'),
    ('batidos', 'coffee shake', 'Batido de espresso, con esencias y crema de leche batida.'),
    ('batidos', 'cappuccino frappeado', 'Espresso, leche y hielo batido.'),
    ('batidos', 'frushake', 'Batido frío de frutas frescas de la estación y yogurt.'),
    ('batidos', 'cappuccino frappeado light', 'Espresso, leche de soya, hielo batido y edulcorante.')
) AS v(category_name, name, description)
JOIN content.menu_categories mc ON mc.name = v.category_name;

